# Copy to .env and fill in. .env is git-ignored; never commit it.

# Camera login used in config/cameras.yml as ${CAM_USER} / ${CAM_PASSWORD}.
# If the password contains special characters (@ : / ? # %), URL-encode them,
# e.g. "p@ss:word" -> "p%40ss%3Aword".
# You can add more variables (e.g. DRIVEWAY_PASSWORD) if cameras differ.
CAM_USER=admin
CAM_PASSWORD=change-me

# Where recordings are stored.
#   - Leave as "recordings" to use a Docker-managed volume (recommended on Windows,
#     and keeps video OUT of OneDrive).
#   - Or set an absolute path, e.g. /mnt/nvr/recordings on the Proxmox host.
RECORDINGS_PATH=recordings

# Log level: DEBUG, INFO, WARNING
BB_LOG_LEVEL=INFO

# Push notifications (https://pushover.net). Easiest is to set these in the app instead:
# the admin pastes the app token under Settings > Alerts, and each person adds their own
# user key under Settings > Your account. Values here still work as a fallback:
#   PUSHOVER_USER:  a user key that gets every alert (in addition to people set up in the app)
#   PUSHOVER_TOKEN: create an Application on pushover.net and paste its API token
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Web app port on this server (default 8090). Point your reverse proxy at it.
WEB_PORT=8090
# Your reverse proxy's IP address(es), comma-separated (e.g. 10.10.10.5). Leave empty
# when not behind a proxy.
TRUSTED_PROXIES=
