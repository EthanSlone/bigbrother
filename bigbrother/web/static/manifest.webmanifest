{
  "id": "/",
  "name": "BigBrother",
  "short_name": "BigBrother",
  "start_url": "/#/live",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1A2631",
  "theme_color": "#1A2631",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/static/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "description": "Your cameras: live view, events, recordings and alerts.",
  "shortcuts": [
    {
      "name": "Events",
      "url": "/#/events",
      "icons": [
        {
          "src": "/static/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Recordings, all cameras",
      "short_name": "Recordings",
      "url": "/#/recordings?cam=all",
      "icons": [
        {
          "src": "/static/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
